{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://keenmate.com/schemas/pure-admin-theme.schema.json",
  "title": "Pure Admin Theme Manifest",
  "description": "Configuration manifest for Pure Admin CSS themes",
  "type": "object",
  "required": ["name", "id", "version", "colorVariants", "exports"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to the JSON schema for validation"
    },
    "name": {
      "type": "string",
      "description": "Display name of the theme"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique identifier for the theme (lowercase, hyphens allowed)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9]+)?$",
      "description": "Semantic version of the theme"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the theme"
    },
    "content": {
      "type": "string",
      "description": "Markdown content for the theme detail page on pureadmin.io"
    },
    "author": {
      "type": "string",
      "description": "Theme author or organization"
    },
    "license": {
      "type": "string",
      "description": "License identifier (e.g., MIT, Apache-2.0)"
    },
    "modeCssClass": {
      "type": "string",
      "default": "pa-mode-{mode}",
      "description": "CSS class pattern for mode switching. Use {mode} as placeholder."
    },
    "variantCssClass": {
      "type": "string",
      "default": "pa-color-{variant}",
      "description": "CSS class pattern for variant switching. Use {variant} as placeholder."
    },
    "colorVariants": {
      "type": "array",
      "description": "Color variants with nested mode definitions and key colors",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "modes", "file"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Variant identifier (empty string for default variant)"
          },
          "name": {
            "type": "string",
            "description": "Display name for the variant"
          },
          "description": {
            "type": "string",
            "description": "Brief description of the color variant"
          },
          "file": {
            "type": "string",
            "description": "Path to the compiled CSS file for this variant"
          },
          "modes": {
            "type": "array",
            "description": "Supported color modes for this variant",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "colors"],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": ["light", "dark"],
                  "description": "Mode identifier"
                },
                "name": {
                  "type": "string",
                  "description": "Display name for the mode"
                },
                "default": {
                  "type": "boolean",
                  "description": "Whether this is the default mode for the variant"
                },
                "colors": {
                  "type": "object",
                  "required": ["accent", "background", "surface", "text"],
                  "properties": {
                    "accent": {
                      "type": "string",
                      "description": "Primary accent color"
                    },
                    "background": {
                      "type": "string",
                      "description": "Main background color"
                    },
                    "surface": {
                      "type": "string",
                      "description": "Card/surface background color"
                    },
                    "text": {
                      "type": "string",
                      "description": "Primary text color"
                    },
                    "header": {
                      "type": "string",
                      "description": "Header background color (optional, shown when distinctive)"
                    },
                    "sidebar": {
                      "type": "string",
                      "description": "Sidebar background color (optional, shown when distinctive)"
                    }
                  },
                  "description": "Key theme colors for this mode"
                }
              }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "description": "Feature flags indicating theme capabilities",
      "properties": {
        "cssVariables": {
          "type": "boolean",
          "default": true,
          "description": "Theme uses CSS custom properties for runtime customization"
        },
        "responsiveLayout": {
          "type": "boolean",
          "default": true,
          "description": "Theme supports responsive layouts"
        },
        "compactMode": {
          "type": "boolean",
          "default": true,
          "description": "Theme supports compact display mode"
        },
        "sidebarCollapse": {
          "type": "boolean",
          "default": true,
          "description": "Theme supports sidebar collapse/expand"
        },
        "sidebarIconMode": {
          "type": "boolean",
          "default": true,
          "description": "Theme supports icon-only sidebar mode"
        },
        "customFonts": {
          "type": "boolean",
          "default": false,
          "description": "Theme includes custom font files"
        },
        "rtlSupport": {
          "type": "boolean",
          "default": false,
          "description": "Theme supports right-to-left layouts"
        },
        "printStyles": {
          "type": "boolean",
          "default": false,
          "description": "Theme includes print-optimized styles"
        }
      }
    },
    "fonts": {
      "type": "object",
      "description": "Font configuration",
      "properties": {
        "family": {
          "type": "string",
          "description": "Primary font family"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL to the font's homepage or specimen page (e.g. Google Fonts)"
        },
        "familyHeading": {
          "type": "string",
          "description": "Heading font family (if different)"
        },
        "familyMono": {
          "type": "string",
          "description": "Monospace font family"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["family", "src"],
            "properties": {
              "family": {
                "type": "string"
              },
              "src": {
                "type": "string"
              },
              "weight": {
                "type": ["string", "integer"]
              },
              "style": {
                "type": "string"
              }
            }
          },
          "description": "Custom font file definitions"
        }
      }
    },
    "exports": {
      "type": "object",
      "description": "File exports for the theme",
      "required": ["css"],
      "properties": {
        "css": {
          "type": "string",
          "description": "Path to compiled CSS file"
        },
        "cssMinified": {
          "type": "string",
          "description": "Path to minified CSS file"
        },
        "scss": {
          "type": "string",
          "description": "Path to main SCSS source file"
        },
        "scssVariables": {
          "type": "string",
          "description": "Path to SCSS variables file for customization"
        }
      }
    },
    "preview": {
      "type": "object",
      "description": "Preview assets for theme showcase",
      "properties": {
        "thumbnail": {
          "type": "string",
          "description": "Path to thumbnail image"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths to screenshot images"
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Static asset files bundled with the theme",
      "properties": {
        "favicon": {
          "type": "string",
          "description": "Path to favicon file (relative to theme dir)"
        },
        "logo": {
          "type": "string",
          "description": "Path to primary logo file"
        },
        "logoSmall": {
          "type": "string",
          "description": "Path to compact/icon logo"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional asset file paths (relative to theme dir)"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Searchable tags (e.g. 'dark', 'industrial', 'restaurant', 'warm')"
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "URL to theme's homepage or repository"
    },
    "coreVersion": {
      "type": "string",
      "description": "Required pure-admin-core version range (e.g. '>=1.5.0')"
    },
    "checksums": {
      "type": "object",
      "description": "SHA-256 checksums of packaged files, computed by pack-theme.js. Used by pure-theme-park to detect changes on upload.",
      "properties": {
        "css": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 of the compiled CSS file (sha256:<hex>)"
        },
        "scss": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA-256 of the SCSS source file (sha256:<hex>)"
        },
        "assets": {
          "type": "object",
          "description": "SHA-256 checksums of bundled assets, keyed by ZIP-relative path",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "description": "Theme dependencies",
      "properties": {
        "core": {
          "type": "string",
          "description": "Required pure-admin-core version"
        }
      }
    }
  }
}
