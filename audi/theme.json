{
  "$schema": "../schemas/pure-admin-theme.schema.json",
  "name": "Audi",
  "id": "audi",
  "version": "2.9.0",
  "description": "Premium dark theme inspired by Audi's design language with red accents",
  "content": "## Audi\n\nA premium dark theme drawing inspiration from Audi's iconic design language. Deep blacks and precise red accents create a sophisticated, high-contrast interface.\n\n### Highlights\n\n- **Dark-first design** with carefully tuned contrast ratios\n- **Red accent (#bb0a30)** for interactive elements and focus states\n- **Fira Sans Condensed** bundled font for a sleek, condensed typographic feel\n- Light mode included for well-lit environments\n\n### Usage\n\n```html\n<link rel=\"stylesheet\" href=\"css/audi.css\">\n```\n\nThe theme defaults to dark mode. Switch with `pc-mode-light` / `pc-mode-dark` on `<body>`. Auto-switching via `prefers-color-scheme` is enabled by default.",
  "author": "KeenMate",
  "license": "MIT",

  "modeCssClass": "pc-mode-{mode}",
  "variantCssClass": "pa-color-{variant}",

  "colorVariants": [
    {
      "id": "",
      "name": "Default",
      "file": "dist/audi.css",
      "modes": [
        {
          "id": "dark",
          "name": "Dark",
          "default": true,
          "colors": {
            "accent": "#ff0000",
            "background": "#0a0a0a",
            "surface": "#1a1a1a",
            "text": "#ffffff",
            "header": "#000000",
            "sidebar": "#1a1a1a"
          }
        },
        {
          "id": "light",
          "name": "Light",
          "colors": {
            "accent": "#ff0000",
            "background": "#f8f9fa",
            "surface": "#ffffff",
            "text": "#212529",
            "header": "#f8f9fa",
            "sidebar": "#ffffff"
          }
        }
      ]
    }
  ],

  "features": {
    "cssVariables": true,
    "responsiveLayout": true,
    "compactMode": true,
    "sidebarCollapse": true,
    "sidebarIconMode": true,
    "customFonts": true,
    "rtlSupport": false,
    "printStyles": false
  },

  "fonts": {
    "family": "Fira Sans Condensed, Arial Narrow, Arial, sans-serif",
    "url": "https://fonts.google.com/specimen/Fira+Sans+Condensed",
    "files": [
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfvtrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfLtrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfrtrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfXtrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfntrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfjtrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfbtrQ.woff2", "weight": 400, "style": "normal" }
    ]
  },

  "exports": {
    "css": "./dist/audi.css",
    "scss": "./src/scss/audi.scss"
  },

  "dependencies": {
    "core": "^2.9.0-rc06"
  }
}
