{
  "$schema": "../schemas/pure-admin-theme.schema.json",
  "name": "Express",
  "id": "express",
  "version": "2.3.4",
  "description": "Bold yellow and red theme inspired by logistics brands",
  "content": "## Express\n\nA bold, high-energy theme inspired by the visual identity of logistics and delivery brands. Bright yellow headers and red accents make for an unmistakable, action-oriented interface.\n\n### Highlights\n\n- **Yellow header (#FFCC00)** and **red accent (#D40511)** for a striking, branded look\n- **Fira Sans Condensed** bundled font for a compact, industrial feel\n- **Black sidebar** contrasting against light content areas\n- Dark mode included with adjusted contrast\n\n### Usage\n\n```html\n<link rel=\"stylesheet\" href=\"css/express.css\">\n```\n\nDefaults to light mode. Switch with `pa-mode-light` / `pa-mode-dark` on `<body>`. Auto-switching via `prefers-color-scheme` is enabled by default.",
  "author": "KeenMate",
  "license": "MIT",

  "modeCssClass": "pa-mode-{mode}",
  "variantCssClass": "pa-color-{variant}",

  "colorVariants": [
    {
      "id": "",
      "name": "Default",
      "file": "dist/express.css",
      "modes": [
        {
          "id": "light",
          "name": "Light",
          "default": true,
          "colors": {
            "accent": "#D40511",
            "background": "#F2F2F2",
            "surface": "#ffffff",
            "text": "#333333",
            "header": "#FFCC00",
            "sidebar": "#000000"
          }
        },
        {
          "id": "dark",
          "name": "Dark",
          "colors": {
            "accent": "#D40511",
            "background": "#1a1a1a",
            "surface": "#242424",
            "text": "#ffffff",
            "header": "#FFCC00",
            "sidebar": "#1a1a1a"
          }
        }
      ]
    }
  ],

  "features": {
    "cssVariables": true,
    "responsiveLayout": true,
    "compactMode": true,
    "sidebarCollapse": true,
    "sidebarIconMode": true,
    "customFonts": true,
    "rtlSupport": false,
    "printStyles": false
  },

  "fonts": {
    "family": "Fira Sans Condensed, Arial Narrow, Arial, sans-serif",
    "url": "https://fonts.google.com/specimen/Fira+Sans+Condensed",
    "files": [
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfvtrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfLtrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfrtrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfXtrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfntrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfjtrftV.woff2", "weight": 400, "style": "normal" },
      { "family": "Fira Sans Condensed", "src": "assets/fonts/wEOhEADFm8hSaQTFG18FErVhsC9x-tarUfbtrQ.woff2", "weight": 400, "style": "normal" }
    ]
  },

  "exports": {
    "css": "./dist/express.css",
    "scss": "./src/scss/express.scss"
  },

  "dependencies": {
    "core": "^2.3.4"
  }
}
